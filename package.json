{
  "name": "oversteer",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:old": "node --test test/enemies.test.js test/pickups.test.js test/scoring.test.js test/trail.test.js test/upgrades.test.js test/utility.test.js test/waves.test.js test/bench.test.js",
    "build:bench": "tsc && vite build --base=/dist-local/ --outDir=dist-local --target=esnext && node -e \"const fs=require('fs'),f='dist-local/index.html',h=fs.readFileSync(f,'utf8');fs.writeFileSync(f,h.replace('<head>','<head><base href=\\\"/dist-local/\\\">'));\"",
    "bench": "vitest bench src/bench/logicBench.bench.ts",
    "bench:serve": "npx http-server . -p 3000 -c-1",
    "bench:web": "npm run build:bench && npm run bench:serve"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.0.0"
  }
}
